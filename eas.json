{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.19.0"
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging"
      },
      "distribution": "internal"
    },
    "testflight": {
      "extends": "base",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.divergentclub.ru",
        "EXPO_PUBLIC_APP_PUBLIC_URL": "https://staging.divergentclub.ru",
        "EXPO_PUBLIC_APP_SCHEME": "divergent",
        "EXPO_PUBLIC_TELEGRAM_BOT_URL": "https://t.me/divergent_app_test_bot/start"
      },
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6765858587"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6765858587"
      }
    }
  }
}
