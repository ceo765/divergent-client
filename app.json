{
  "expo": {
    "name": "Divergent",
    "slug": "divergent-client",
    "owner": "divergent_maxx",
    "scheme": "divergent",
    "icon": "./public/icon.jpg",
    "plugins": [
      "expo-notifications",
      "expo-localization",
      "./plugins/withHealthKitPod.cjs"
    ],
    "android": {
      "package": "com.spritemedia.divergent"
    },
    "ios": {
      "bundleIdentifier": "com.spritemedia.divergent",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tg"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Divergent показывает твою активность - шаги, дистанцию и тренировки - на экране «Прогресс».",
        "NSHealthUpdateUsageDescription": "Divergent может записывать тренировки в приложение «Здоровье»."
      }
    },
    "extra": {
      "eas": {
        "projectId": "619f4990-0c03-46ec-9dab-e4e5ff429b48"
      }
    }
  }
}
